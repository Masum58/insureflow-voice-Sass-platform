# App Settings
APP_NAME="InsureFlow AI"
SECRET_KEY=your_secret_key_here

# OpenAI Settings (For RAG/Embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Vapi Voice AI Settings
VAPI_API_KEY=your_vapi_api_key_here
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret_here
VAPI_DEEPGRAM_CREDENTIAL_ID=your_deepgram_credential_id
VAPI_ELEVENLABS_CREDENTIAL_ID=your_elevenlabs_credential_id

# Twilio Settings (For Phone Calls)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# GoHighLevel (GHL) CRM Settings
GHL_API_KEY=your_ghl_api_key_here
GHL_BASE_URL=https://services.leadconnectorhq.com

# Redis Settings (For Background Tasks)
REDIS_URL=redis://localhost:6379

# Database Partner API Settings
DB_API_URL=your_db_api_url_here
DB_API_KEY=your_db_api_key_here

# Calendly Settings
CALENDLY_API_KEY=your_calendly_personal_access_token
CALENDLY_EVENT_TYPE_URI=your_calendly_event_type_uri
